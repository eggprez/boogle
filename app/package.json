  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.7.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
