# ---- required ---------------------------------------------------------------
# Random secret for SearXNG (openssl rand -hex 32)
SEARXNG_SECRET=

# Long-lived OAuth token for the Claude Code CLI, generated from your
# subscription with:   docker compose run --rm boogle claude setup-token
# (Alternative: leave empty and run `docker compose run --rm boogle claude`,
# then /login; credentials persist in the boogle-claude-home volume.)
CLAUDE_CODE_OAUTH_TOKEN=

# ---- site -------------------------------------------------------------------
SITE_NAME=Boogle
PUBLIC_URL=https://search.example.com
ACCENT_COLOR=#6d28d9

# ---- network ----------------------------------------------------------------
# Where the app is published on the host. Keep 127.0.0.1 if NGINX runs on the
# same host; use 0.0.0.0 if NGINX runs elsewhere (then firewall the port!).
BIND_ADDRESS=127.0.0.1
BOOGLE_PORT=8081

# ---- auth -------------------------------------------------------------------
# proxy = trust the user header set by TinyAuth (default)
# none  = no auth at all; only for LAN-only or local testing
AUTH_MODE=proxy
AUTH_USER_HEADER=Remote-User
# Optional: NGINX sends `proxy_set_header X-Proxy-Secret "<value>"`; requests
# without it are refused even if they carry a Remote-User header.
AUTH_PROXY_SECRET=
# Optional comma-separated list of usernames allowed to use the site.
ALLOWED_USERS=

# ---- reddit worker ------------------------------------------------------------
# Headless browser that backfills Reddit results (README, "Reddit through a
# headless browser"). Set REDDIT_WORKER_URL to an empty value to switch it off.
# REDDIT_WORKER_URL=http://reddit:8080
REDDIT_MIN_INTERVAL_MS=5000
REDDIT_CACHE_TTL_HOURS=72
REDDIT_WEIGHT=0.8

# ---- overview tuning ----------------------------------------------------------
OVERVIEW_TIMEOUT_SECONDS=120
OVERVIEW_CACHE_TTL_HOURS=168
MAX_CONCURRENT_OVERVIEWS=2
DEEP_READ_PAGES=5
SNIPPET_SOURCES=10
